{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "dotnet build ${workspaceFolder}/McpSqlServerTools.sln",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test",
      "type": "shell",
      "command": "dotnet test ${workspaceFolder}/McpSqlServerTools.sln",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "seed demo db",
      "type": "shell",
      "command": "sqlite3 ${workspaceFolder}/demo/dealership.db < ${workspaceFolder}/demo/seed.sql",
      "problemMatcher": []
    }
  ]
}
